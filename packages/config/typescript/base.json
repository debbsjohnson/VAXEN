{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@vaxen/ui": ["../../packages/ui/src"],
      "@vaxen/types": ["../../packages/types/src"],
      "@vaxen/config": ["../../packages/config"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
