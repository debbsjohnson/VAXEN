# Database
DATABASE_URL="postgresql://vaxen:vaxen_password@localhost:5432/vaxen"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_SECRET="your-jwt-secret-key-here-change-in-production"
