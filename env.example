# Provider API Keys (Optional - all calls are mocked by default)
AIRWALLEX_API_KEY=""
AIRWALLEX_SECRET=""
AIRWALLEX_BASE_URL="https://api.airwallex.com"

PRIVY_APP_ID=""
PRIVY_SECRET=""
